# Claim Dispute Review Copilot -- environment template.
# Copy this file to .env and fill in real values locally. Never commit .env.
# No value in this file is a real secret -- placeholders and safe defaults only.

# rag/embeddings.py: which embedding provider to use for Vector RAG.
# "tfidf" is the offline default used by tests/evals and requires no API key.
RAG_EMBEDDING_PROVIDER=tfidf

# application/config.py: required before any live investigation-brief
# generation call (application/llm_adapter.py). Leave blank for the offline
# test/eval baseline -- attempting live generation without it raises
# LLMConfigurationError and makes no network call.
OPENAI_API_KEY=

# application/config.py: required before live generation. This must be set
# to an actual model name before live generation is attempted -- the
# placeholder below is NOT a real model identifier.
LLM_MODEL=REPLACE_WITH_MODEL_NAME_BEFORE_LIVE_GENERATION

# application/config.py: optional, defaults to 30 seconds if unset.
LLM_TIMEOUT_SECONDS=30
